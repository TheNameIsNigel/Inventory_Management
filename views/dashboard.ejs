<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            position: relative;
        }

        .watermark {
            position: fixed;
            bottom: 10px;
            right: 10px;
            opacity: 0.5;
            font-size: 14px;
            color: #666;
            z-index: 99;
        }
        .filter-form {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Welcome, <%= username.split(' ')[0] %>!</h1>
        <a href="/logout" class="btn btn-danger mb-3">Logout</a>

        <div class="card mb-4">
            <div class="card-header">
                <h2>Manage Stores</h2>
            </div>
            <div class="card-body">
                <form action="/create-store" method="post" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="storeName" class="form-control" placeholder="Enter Store SAP ID" required>
                        <input type="text" name="storeAddress" class="form-control" placeholder="Enter store address (optional)">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary">Create Store</button>
                        </div>
                    </div>
                </form>
                <ul class="list-group">
                    <% stores.forEach(function(store) { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <%= store.name %> - <%= store.address %>
                            <a href="/store/<%= store.id %>" class="btn btn-sm btn-info">View Scans</a>
                        </li>
                    <% }); %>
                </ul>                
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2>Manage Dealer Codes</h2>
            </div>
            <div class="card-body">
                <form action="/add-dealer-code" method="post" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="dealerCode" class="form-control" placeholder="Enter new dealer code" required>
                        <input type="text" name="dealerName" class="form-control" placeholder="Enter dealer name" required>
                        <select name="storeId" class="form-control" required>
                            <option value="">Select Store</option>
                            <% stores.forEach(function(store) { %>
                                <option value="<%= store.id %>"><%= store.name %></option>
                            <% }); %>
                        </select>
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary">Add Code</button>
                        </div>
                    </div>
                </form>
                <ul class="list-group">
                    <% dealerCodes.forEach(function(code) { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <%= code.code %> (<%= code.name %>) - Store: <%= code.store_id %>
                            <form action="/delete-dealer-code/<%= code.id %>" method="post">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2>Assign Admins to Stores</h2>
            </div>
            <div class="card-body">
                <form action="/assign-admin" method="post">
                    <div class="form-group">
                        <label for="userId">Select User:</label>
                        <select id="userId" name="userId" class="form-control" required>
                            <option value="">Select User</option>
                            <% users.forEach(function(user) { %>
                                <option value="<%= user.id %>"><%= user.username %> (<%= user.email %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="storeId">Select Store:</label>
                        <select id="storeId" name="storeId" class="form-control" required>
                            <option value="">Select Store</option>
                            <% stores.forEach(function(store) { %>
                                <option value="<%= store.id %>"><%= store.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Assign Admin</button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2>Assign Dealers to Stores</h2>
            </div>
            <div class="card-body">
                <form action="/assign-dealer" method="post">
                    <div class="form-group">
                        <label for="dealerId">Select Dealer:</label>
                        <select id="dealerId" name="dealerId" class="form-control" required>
                            <option value="">Select Dealer</option>
                            <% dealerCodes.forEach(function(dealer) { %>
                                <option value="<%= dealer.id %>"><%= dealer.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="storeId">Select Store:</label>
                        <select id="storeId" name="storeId" class="form-control" required>
                            <option value="">Select Store</option>
                            <% stores.forEach(function(store) { %>
                                <option value="<%= store.id %>"><%= store.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Assign Dealer</button>
                </form>
            </div>
        </div>

        <div class="filter-form">
            <h2>Filters</h2>
            <form method="GET" action="/dashboard">
                <div class="form-row">
                    <div class="col">
                        <label for="startDate">Start Date:</label>
                        <input type="date" id="startDate" name="startDate" class="form-control" value="<%= startDate %>">
                    </div>
                    <div class="col">
                        <label for="endDate">End Date:</label>
                        <input type="date" id="endDate" name="endDate" class="form-control" value="<%= endDate %>">
                    </div>
                    <div class="col">
                        <label for="store">Store:</label>
                        <select id="store" name="store" class="form-control">
                            <option value="">All</option>
                            <% stores.forEach(function(store) { %>
                                <option value="<%= store.id %>" <%= store.id == storeId ? 'selected' : '' %>><%= store.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col">
                        <label for="dealerCode">Dealer Code:</label>
                        <select id="dealerCode" name="dealerCode" class="form-control">
                            <option value="">All</option>
                            <% dealerCodes.forEach(function(code) { %>
                                <option value="<%= code.id %>" <%= code.id == dealerCodeId ? 'selected' : '' %>><%= code.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary mt-4">Filter</button>
                        <a href="/dashboard" class="btn btn-secondary mt-4">Clear</a>
                    </div>
                </div>
            </form>
        </div>
        

        <h2>Scanned Items</h2>
        <table class="table" id="scan-table">
            <thead>
                <tr>
                    <th>SKU (UPC)</th>
                    <th>IMEI</th>
                    <th>Dealer Code</th>
                    <th>Dealer Name</th>
                    <th>Store Name</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody id="scan-table-body">
                <% scans.forEach(function(scan) { %>
                    <tr>
                        <td><%= scan.sku %></td>
                        <td><%= scan.imei %></td>
                        <td><%= scan.dealerCode %></td>
                        <td><%= scan.dealerName %></td>
                        <td><%= scan.storeName %></td>
                        <td><%= scan.timestamp %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="watermark">
            Logged in as: <%= username %><br>
            Current Time: <span id="current-time"></span>
        </div>
    </div>

    <script>
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleString();
            document.getElementById('current-time').textContent = timeString;
        }

        updateTime();
        setInterval(updateTime, 1000);
    </script>
</body>
</html>