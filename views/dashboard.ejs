<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            position: relative;
        }

        .watermark {
            position: fixed;
            bottom: 10px;
            right: 10px;
            opacity: 0.5;
            font-size: 14px;
            color: #666;
            z-index: 99; /* Ensure it's below other content */
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Welcome, <%= username.split(' ')[0] %>!</h1>
        <a href="/logout" class="btn btn-danger mb-3">Logout</a>

        <div class="card mb-4">
            <div class="card-header">
                <h2>Manage Dealer Codes</h2>
            </div>
            <div class="card-body">
                <form action="/add-dealer-code" method="post" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="dealerCode" class="form-control" placeholder="Enter new dealer code" required>
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary">Add Code</button>
                        </div>
                    </div>
                </form>
                <ul class="list-group">
                    <% dealerCodes.forEach(function(code) { %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <%= code.code %>
                            <form action="/delete-dealer-code/<%= code.id %>" method="post">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            </div>
        </div>

        <h2>Scanned Products</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>SKU/UPC</th>
                    <th>IMEI</th>
                    <th>Timestamp</th>
                    <th>Dealer Code</th>
                </tr>
            </thead>
            <tbody>
                <% scans.forEach(function(scan) { %>
                    <tr>
                        <td><%= scan.type === 'UPC' ? scan.value : '' %></td>
                        <td><%= scan.type === 'IMEI' ? scan.value : '' %></td>
                        <td><%= scan.timestamp %></td>
                        <td><%= scan.dealer_code %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="watermark">
            Logged in as: <%= username %><br>
            Current Time: <span id="current-time"></span>
        </div>
    </div>

    <script>
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleString();
            document.getElementById('current-time').textContent = timeString;
        }

        updateTime(); // Initial update
        setInterval(updateTime, 1000); // Update every second
    </script>
</body>
</html>